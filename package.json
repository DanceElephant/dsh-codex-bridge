{
  "name": "dsh-codex-skill-bridge",
  "version": "0.2.0",
  "description": "Import local Codex skills and plugin skills into DeepSeek Harness without executing them: reference or snapshot registration, description compression, atomic lockfile, 6 tools + CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "bridge": "bin/bridge.mjs",
    "codex-skill-bridge": "bin/bridge.mjs"
  },
  "files": [
    "bin",
    "lib",
    "test",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "node test/fixtures/build-fixtures.mjs",
    "coverage:check": "node scripts/check-coverage.mjs"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "skills",
    "plugin",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanceElephant/dsh-codex-skill-bridge.git"
  },
  "homepage": "https://github.com/DanceElephant/dsh-codex-skill-bridge#readme",
  "bugs": {
    "url": "https://github.com/DanceElephant/dsh-codex-skill-bridge/issues"
  }
}
